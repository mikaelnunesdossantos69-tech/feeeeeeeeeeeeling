-- GRAVITY COIL
local coilEnabled=false
local gravityConn=nil
local originalGravity=workspace.Gravity
local originalJump=nil

local function applyGravity(enable)
    local char=M.Character
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    if enable then
        if not originalJump then originalJump=hum.JumpPower end
        hum.JumpPower=50
        hum.UseJumpPower=true
        workspace.Gravity=60
        
        if gravityConn then gravityConn:Disconnect() end
        gravityConn=Y.Heartbeat:Connect(function()
            if not coilEnabled then return end
            local c=M.Character
            if not c then return end
            local h=c:FindFirstChildOfClass("Humanoid")
            if h then
                h.JumpPower=50
                h.UseJumpPower=true
            end
            workspace.Gravity=60
        end)
    else
        if gravityConn then gravityConn:Disconnect() gravityConn=nil end
        workspace.Gravity=originalGravity
        local c=M.Character
        if c then
            local h=c:FindFirstChildOfClass("Humanoid")
            if h and originalJump then h.JumpPower=originalJump end
        end
    end
end

local function createCoil()
    local tool=Instance.new("Tool")
    tool.Name="GravityCoil"
    tool.RequiresHandle=true
    tool.CanBeDropped=false
    tool.ToolTip="Reduz gravidade"
    
    local handle=Instance.new("Part")
    handle.Name="Handle"
    handle.Size=Vector3.new(1,2,1)
    handle.Transparency=1
    handle.CanCollide=false
    handle.Parent=tool
    
    local mesh=Instance.new("SpecialMesh")
    mesh.MeshType=Enum.MeshType.FileMesh
    mesh.MeshId="rbxassetid://1082548970"
    mesh.TextureId=""
    mesh.Parent=handle
    
    handle.Color=Color3.fromRGB(50,100,255)
    handle.Material=Enum.Material.Plastic
    
    local light=Instance.new("PointLight")
    light.Color=Color3.fromRGB(50,100,255)
    light.Range=6
    light.Brightness=1.2
    light.Parent=handle
    
    local sound=Instance.new("Sound")
    sound.Name="CoilSound"
    sound.SoundId="rbxassetid://9125402735"
    sound.Volume=0.5
    sound.Looped=true
    sound.Parent=handle
    
    tool.Equipped:Connect(function()
        coilEnabled=true
        applyGravity(true)
        if sound then pcall(function() sound:Play() end) end
    end)
    
    tool.Unequipped:Connect(function()
        coilEnabled=false
        applyGravity(false)
        if sound then pcall(function() sound:Stop() end) end
    end)
    
    tool.Grip=CFrame.new(0,-0.2,-0.3)*CFrame.Angles(math.rad(90),0,0)
    return tool
end

