            btnOldLights.Text="Old Lights: Ativado ✓"
            btnOldLights.BackgroundColor3=q
        else
            oldLightsLoaded=false
            btnOldLights.Text="Old Lights: Erro ❌"
            btnOldLights.BackgroundColor3=p
            warn("[Old Lights] Erro: "..tostring(erro))
            restaurarLighting(oldLightsSnapshot)
            oldLightsSnapshot=nil
        end
    else
        -- ⏹ DESATIVAR — restaura tudo
        restaurarLighting(oldLightsSnapshot)
        oldLightsSnapshot=nil
        oldLightsLoaded=false
        btnOldLights.Text="Old Lights: Desativado"
        btnOldLights.BackgroundColor3=p
    end
end)
