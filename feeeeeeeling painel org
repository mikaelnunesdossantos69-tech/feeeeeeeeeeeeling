-- 🌙 OLD LIGHTS (ativar / desativar)
-- ═══════════════════════════════════════════
local oldLightsLoaded=false
local oldLightsSnapshot=nil

-- Propriedades de Lighting que vamos salvar/restaurar
local PROPS_LIGHTING={
    "Ambient","OutdoorAmbient","Brightness","ClockTime","TimeOfDay",
    "GeographicLatitude","FogColor","FogStart","FogEnd","FogMode",
    "ColorShift_Top","ColorShift_Bottom","ExposureCompensation",
    "EnvironmentDiffuseScale","EnvironmentSpecularScale",
    "GlobalShadows","ShadowSoftness","OutdoorAmbient"
}

local function capturarLighting()
    local props={}
    for _,nome in ipairs(PROPS_LIGHTING) do
        local ok,valor=pcall(function() return k[nome] end)
        if ok then props[nome]=valor end
    end
    local children={}
    for _,child in ipairs(k:GetChildren()) do
        children[child]=true
    end
    return {props=props, children=children}
end

local function restaurarLighting(snap)
    if not snap then return end
    -- Restaura propriedades
    for nome,valor in pairs(snap.props) do
        pcall(function() k[nome]=valor end)
    end
    -- Remove instâncias que o script criou (Atmosphere, Sky, ColorCorrection, etc)
    for _,child in ipairs(k:GetChildren()) do
        if not snap.children[child] then
            pcall(function() child:Destroy() end)
        end
    end
end

btnOldLights.MouseButton1Click:Connect(function()
    if not oldLightsLoaded then
        -- ▶ ATIVAR
        btnOldLights.Text="Old Lights: Carregando..."
        btnOldLights.BackgroundColor3=q

        oldLightsSnapshot=capturarLighting()

        local sucesso,erro=pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/mikaelnunesdossantos69-tech/old-light/refs/heads/main/old%20lights"))()
        end)

        task.wait(0.6)

        if sucesso then
